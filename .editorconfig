# EditorConfig — https://editorconfig.org
# ktlint 가 본 파일을 직접 읽어 코드 스타일을 결정한다.

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 140

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# Unit을 반환하는 Composable은 PascalCase를 사용한다. 일반 함수 이름 검사는 유지한다.
ktlint_standard_function-naming = enabled
ktlint_function_naming_ignore_when_annotated_with = Composable
# 클래스 본문 첫 빈 줄과 Modifier 체인의 기존 서식을 허용한다.
# ktlint 1.5.0에서 줄바꿈 규칙 간 충돌은 재현되지 않았다. 검토 근거: config/README.md
ktlint_standard_no-empty-first-line-in-class-body = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
